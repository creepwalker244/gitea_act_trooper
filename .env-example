# .env для Gitea/Forgejo CI/CD пайплайна
# Скопируйте в .env и заполните своими значениями

# ─── Docker образ ───────────────────────────
IMAGE_ENV_NAME=sdh-breath-service
CONTAINER_ENV_NAME=sdh-breath-service

# ─── Порты ──────────────────────────────────
ENV_SERVICE_HOST_PORT=8000
ENV_SERVICE_CONTAINER_PORT=8000

# ─── Удалённый хост ─────────────────────────
SSH_HOST=127.0.0.0
SSH_USER=root
SSH_PORT=22
# SSH_KEY — приватный ключ (многострочный, поэтому в .env его лучше не хранить)
# Добавьте его как секрет в репозитории: Settings → Secrets → SSH_KEY

# ─── Перезапуск контейнера ──────────────────
RESTART_POLICY=unless-stopped

# ─── Ветки для триггера ─────────────────────
TARGET_BRANCH=main
